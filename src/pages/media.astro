---
export const prerender = true

import DefaultPageLayout from '$/layouts/default.astro'
import MediaPreviewList from '$/components/MediaPreviewList.astro'
import { SITE } from '../config'
import { toFeedToJsonUrl, toMediaFormatFromFeed2JsonUrl } from '../utils/media-yt-feed'
import localMediaData from '../data/astro-media.json'

/* Astro Ink's Media settings */

/* The usual stuff...*/

let title = 'Videos & Screencasts';
let description = 'All the great videos on Astro we could find for ya!'

let allPosts;
// If YT channelId is present, fetch from YouTube
if (SITE.ytChannelId) {
    const response = await fetch(toFeedToJsonUrl(SITE.ytChannelId))
    allPosts = toMediaFormatFromFeed2JsonUrl(await response.json())
} else {
    // Use local media data to avoid network issues during build
    allPosts = localMediaData
}

const sortedPosts = allPosts.sort((a, b) => new Date(b.date) - new Date(a.date))
---
<DefaultPageLayout content={{ title, description }}>
    <MediaPreviewList posts={sortedPosts} />
</DefaultPageLayout>
